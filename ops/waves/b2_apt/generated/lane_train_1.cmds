DV3_TASK_NAME=se_apt_s68 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START se_apt_s68 ====="; RUN_ID=se_apt_s68 TASK=dmc_cheetah_run SEED=68 EXPL_CONFIG=expl_apt DISTRACTOR_MOD_KEY= DISTRACTOR_MOD_INDEX=0 DISTRACTOR_MOD_LO=0.0 DISTRACTOR_MOD_HI=1.0 DISTRACTOR_SCALE=1.0 bash scripts/uncfield_se.sbatch && python -m uncfield.se_apt_mask --run_logdir "$RUNROOT/se_apt_s68"; rc=$?; echo "===== [$(date)] DONE rc=$rc se_apt_s68 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/se_apt_s68.out" 2>&1'
