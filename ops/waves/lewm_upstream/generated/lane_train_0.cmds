# lewm_upstream / stage train / lane 0 / 2 queued task(s), 4 run(s)
DV3_TASK_NAME=lewm_upstream_train_l0_pair00 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START lewm_finger_s0_seed1 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 0 1; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s0_seed1 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s0_seed1.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START lewm_finger_s0_seed2 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 0 2; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s0_seed2 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s0_seed2.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
DV3_TASK_NAME=lewm_upstream_train_l0_pair01 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START lewm_finger_s1_seed1 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 1 1; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s1_seed1 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s1_seed1.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START lewm_finger_s1_seed2 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 1 2; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s1_seed2 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s1_seed2.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
