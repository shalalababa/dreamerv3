# lewm_upstream / stage train / lane 3 / 2 queued task(s), 4 run(s)
DV3_TASK_NAME=lewm_upstream_train_l3_pair00 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START lewm_finger_s0_seed7 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 0 7; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s0_seed7 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s0_seed7.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START lewm_finger_s0_seed8 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 0 8; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s0_seed8 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s0_seed8.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
DV3_TASK_NAME=lewm_upstream_train_l3_pair01 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START lewm_finger_s1_seed7 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 1 7; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s1_seed7 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s1_seed7.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START lewm_finger_s1_seed8 ====="; bash "$REPO/scripts/ops/runners/lewm_train_one.sh" 1 8; rc=$?; echo "===== [$(date)] DONE rc=$rc lewm_finger_s1_seed8 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/lewm_finger_s1_seed8.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
