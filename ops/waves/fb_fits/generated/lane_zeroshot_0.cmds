# fb_fits / stage zeroshot / lane 0 / 2 queued task(s), 4 run(s)
DV3_TASK_NAME=fb_fits_zeroshot_l0_pair00 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; mkdir -p "$RUNROOT/fbwm_finger_q1s0_seed1"; mkdir -p "$RUNROOT/fbwm_finger_q1s1_seed1"; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s0_seed1 ====="; if [ ! -f "$RUNROOT/fbwm_finger_q1s0_seed1/FB_FIT_DONE" ]; then echo "REFUSE fbwm_finger_q1s0_seed1: FB_FIT_DONE absent -- fit did not complete"; exit 3; fi; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_zeroshot eval --ckpt "$RUNROOT/fbwm_finger_q1s0_seed1/fb_ckpt.pt" --data "$RUNROOT/fb_data/finger_q1_side0.npz" --seed 1 --output "$RUNROOT/fbwm_finger_q1s0_seed1/zeroshot.json"; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s0_seed1 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s0_seed1.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s1_seed1 ====="; if [ ! -f "$RUNROOT/fbwm_finger_q1s1_seed1/FB_FIT_DONE" ]; then echo "REFUSE fbwm_finger_q1s1_seed1: FB_FIT_DONE absent -- fit did not complete"; exit 3; fi; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_zeroshot eval --ckpt "$RUNROOT/fbwm_finger_q1s1_seed1/fb_ckpt.pt" --data "$RUNROOT/fb_data/finger_q1_side1.npz" --seed 1 --output "$RUNROOT/fbwm_finger_q1s1_seed1/zeroshot.json"; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s1_seed1 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s1_seed1.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
