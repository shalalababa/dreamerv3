# fb_fits / stage fit / lane 2 / 2 queued task(s), 4 run(s)
DV3_TASK_NAME=fb_fits_fit_l2_pair00 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s0_seed3 ====="; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_fit fit --data "$RUNROOT/fb_data/finger_q1_side0.npz" --logdir "$RUNROOT/fbwm_finger_q1s0_seed3" --seed 3 --updates 500000; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s0_seed3 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s0_seed3.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s1_seed3 ====="; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_fit fit --data "$RUNROOT/fb_data/finger_q1_side1.npz" --logdir "$RUNROOT/fbwm_finger_q1s1_seed3" --seed 3 --updates 500000; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s1_seed3 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s1_seed3.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
DV3_TASK_NAME=fb_fits_fit_l2_pair01 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s0_seed7 ====="; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_fit fit --data "$RUNROOT/fb_data/finger_q1_side0.npz" --logdir "$RUNROOT/fbwm_finger_q1s0_seed7" --seed 7 --updates 500000; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s0_seed7 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s0_seed7.out" 2>&1 & p1=$!; ( set +e; echo "===== [$(date)] START fbwm_finger_q1s1_seed7 ====="; MUJOCO_GL=disabled CONTROLLABLE_AGENT_ROOT=/workspace/controllable_agent /workspace/conda_envs/fb/bin/python -m probing.fb_fit fit --data "$RUNROOT/fb_data/finger_q1_side1.npz" --logdir "$RUNROOT/fbwm_finger_q1s1_seed7" --seed 7 --updates 500000; rc=$?; echo "===== [$(date)] DONE rc=$rc fbwm_finger_q1s1_seed7 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/fbwm_finger_q1s1_seed7.out" 2>&1 & p2=$!; wait $p1; r1=$?; wait $p2; r2=$?; if [ $r1 -ne 0 ] || [ $r2 -ne 0 ]; then exit 1; fi'
