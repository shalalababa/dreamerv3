# vf_adapts / stage vfontask / lane 1 / 2 queued task(s), 2 run(s)
DV3_TASK_NAME=adapt_ontask_finger_seed18_ckpt500000 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START adapt_ontask_finger_seed18_ckpt500000 ====="; DV3_TASK_NAME=adapt_ontask_finger_seed18_ckpt500000 python dreamerv3/main.py --logdir ${RUNROOT}/adapt_ontask_finger_seed18_ckpt500000 --configs dmc_proprio unfrozen_readout --task dmc_finger_turn_hard --seed 18 --run.from_checkpoint ${RUNROOT}/ontask_finger_seed18/ckpt/$(cat ${RUNROOT}/ontask_finger_seed18/ckpt/latest) --run.steps 1.25e5 --env.dmc.render False; rc=$?; echo "===== [$(date)] DONE rc=$rc adapt_ontask_finger_seed18_ckpt500000 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/adapt_ontask_finger_seed18_ckpt500000.out" 2>&1'
DV3_TASK_NAME=adapt_ontask_finger_seed22_ckpt500000 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START adapt_ontask_finger_seed22_ckpt500000 ====="; DV3_TASK_NAME=adapt_ontask_finger_seed22_ckpt500000 python dreamerv3/main.py --logdir ${RUNROOT}/adapt_ontask_finger_seed22_ckpt500000 --configs dmc_proprio unfrozen_readout --task dmc_finger_turn_hard --seed 22 --run.from_checkpoint ${RUNROOT}/ontask_finger_seed22/ckpt/$(cat ${RUNROOT}/ontask_finger_seed22/ckpt/latest) --run.steps 1.25e5 --env.dmc.render False; rc=$?; echo "===== [$(date)] DONE rc=$rc adapt_ontask_finger_seed22_ckpt500000 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/adapt_ontask_finger_seed22_ckpt500000.out" 2>&1'
