DV3_TASK_NAME=adapt_ax1q1s1_walker_seed1_ckpt500000 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START adapt_ax1q1s1_walker_seed1_ckpt500000 ====="; DV3_TASK_NAME=adapt_ax1q1s1_walker_seed1_ckpt500000 RUN_ID=adapt_ax1q1s1_walker_seed1_ckpt500000 WM_RUN=ax1wm_walker_q1s1_seed1 TASK=dmc_walker_walk SEED=1 REPLAY=${RUNROOT}/axis1_walker/q1/side1 UPDATES=500000 STEPS=1.25e5 AXIS1_EXPL_MODE=task AXIS1_BASE_CONFIG=dmc_proprio AXIS1_ADAPT_CONFIG=frozen_readout DREAMER_DISABLE_GPUFLAGS=1 bash -c '"'"'scores=$(wc -l < "$RUNROOT/$RUN_ID/scores.jsonl" 2>/dev/null || echo 0); if [ -f "$RUNROOT/$RUN_ID/ADAPT_DONE" ] && [ "$scores" -ge 100 ]; then echo "SKIP done: $RUN_ID scores=$scores"; else bash scripts/axis1.sbatch; fi'"'"'; rc=$?; echo "===== [$(date)] DONE rc=$rc adapt_ax1q1s1_walker_seed1_ckpt500000 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/adapt_ax1q1s1_walker_seed1_ckpt500000.out" 2>&1'
