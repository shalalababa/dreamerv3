 ],
 "runs": [
  {
   "stage": "train",
   "kind": "se_run",
   "target": "vast",
   "run_id": "se_noboot_s40",
   "cmd": "RUN_ID=se_noboot_s40 TASK=dmc_cheetah_run SEED=40 DISAG_BOOTSTRAP=False bash scripts/uncfield_se.sbatch",
   "vars": {
    "seed": 40,
    "run_id": "se_noboot_s40"
   },
   "logdir": "se_noboot_s40",
   "outputs": [
    "se_noboot_s40"
   ],
   "inputs": [],
   "done_when": [
    {
     "exists": "TRAINING_DONE"
    },
    {
     "exists": "config.yaml"
    },
    {
     "file_contains": {
      "file": "config.yaml",
      "pattern": "disag_bootstrap: false"
     }
    },
    {
     "file_contains": {
      "file": "ckpt_snapshots/nearest.json",
      "pattern": "\"milestone\": 500000,\\s+\"step\": (49\\d{4}|[5-9]\\d{5})"
     }
    },
    {
     "jsonl_min_lines": {
      "file": "scores.jsonl",
      "n": 464
     }
    }
