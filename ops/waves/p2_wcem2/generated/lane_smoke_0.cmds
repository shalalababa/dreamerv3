# p2_wcem2 / stage smoke / lane 0 / 1 queued task(s), 1 run(s)
DV3_TASK_NAME=wcem2_smoke_gate bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; ( set +e; echo "===== [$(date)] START wcem2_smoke_gate ====="; set -e; export XLA_PYTHON_CLIENT_MEM_FRACTION=0.18; S="${RUNROOT}/_wcem2_smoke"; mkdir -p "$S"; t0=$(date +%s); python -m d0.oracle_labels --run_logdir "${RUNROOT}/r3_local/r3_finger_e1_seed33" --states 5 --horizon 100 --label_every 25 --actions 8 --seed 0 --ref_stride 5 --oracle_all --w1_repeats 8 --cem_consumer --env_seed 20260825 --output "$S/smoke_r3_finger_e1_seed33.npz"; t1=$(date +%s); echo "WCEM2_SMOKE_SECONDS_5_STATES=$((t1-t0))"; rm -rf "$S"; mkdir -p "${RUNROOT}/wcem2_labels"; touch "${RUNROOT}/wcem2_labels/WCEM2_SMOKE_OK"; rc=$?; echo "===== [$(date)] DONE rc=$rc wcem2_smoke_gate ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/wcem2_smoke_gate.out" 2>&1'
