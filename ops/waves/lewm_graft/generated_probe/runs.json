{
 "wave_id": "lewm_graft",
 "spec": "ops/waves/lewm_graft/spec.yaml",
 "prereg": null,
 "bundle": {
  "prefix": "lewm_jp",
  "include_stages": [
   "graft",
   "probe_e4"
  ],
  "cloud_logs": [
   "adapt_ax1jppx*_seed*.out",
   "lewm_probe_e4_*.out",
   "worker_shard*.out"
  ]
 },
 "stages": [
  {
   "name": "graft",
   "target": "vast",
   "kind": "graft_fit_adapt",
   "on_failure": "abort",
   "needs": null
  },
  {
   "name": "probe_e4",
   "target": "vast",
   "kind": "probe",
   "on_failure": "continue",
   "needs": "graft"
  }
 ],
 "runs": [
  {
   "stage": "probe_e4",
   "kind": "probe",
   "target": "vast",
   "run_id": "lewm_probe_e4_s0_seed1",
   "cmd": "DREAMER_DISABLE_GPUFLAGS=1 python -m probing.ridge_probe measure --run_logdir \"$RUNROOT/ax1wm_finger_fpxpxq1ms0_seed1\" --probeset \"$RUNROOT/e4_probesets/fingerpx_v1\" --output \"$RUNROOT/lewm_probe/fpx_s0_seed1.json\" --platform cuda --ep_batch 4",
   "vars": {
    "seed": 1,
    "side": 0,
    "cmd": "DREAMER_DISABLE_GPUFLAGS=1 python -m probing.ridge_probe measure --run_logdir \"$RUNROOT/ax1wm_finger_fpxpxq1ms0_seed1\" --probeset \"$RUNROOT/e4_probesets/fingerpx_v1\" --output \"$RUNROOT/lewm_probe/fpx_s0_seed1.json\" --platform cuda --ep_batch 4",
    "run_id": "lewm_probe_e4_s0_seed1"
   },
   "logdir": "lewm_probe",
   "outputs": [
    "lewm_probe/fpx_s0_seed1.json"
   ],
   "inputs": [
    "e4_probesets/fingerpx_v1",
    "ax1wm_finger_fpxpxq1ms0_seed1"
   ],
   "done_when": [
    {
     "exists": "fpx_s0_seed1.json"
    }
   ]
  },
