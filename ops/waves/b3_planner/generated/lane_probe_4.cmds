# b3_planner / stage probe / lane 4 / 1 queued task(s), 1 run(s)
DV3_TASK_NAME=se_planner_seed14 bash -lc 'set -uo pipefail; source /root/.dreamer_vast_env; cd "$REPO"; mkdir -p "$RUNROOT/_cloud_logs"; mkdir -p "$RUNROOT/se_cheetah_seed14"; ( set +e; echo "===== [$(date)] START se_planner_seed14 ====="; MUJOCO_GL=egl XLA_PYTHON_CLIENT_PREALLOCATE=false python -m uncfield.se_planner_probe --run_logdir "$RUNROOT/se_cheetah_seed14" --platform cuda --seed 0; rc=$?; echo "===== [$(date)] DONE rc=$rc se_planner_seed14 ====="; exit $rc ) >> "$RUNROOT/_cloud_logs/se_planner_seed14.out" 2>&1'
