#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# dv3ops -- experiment operations CLI  (P0, 2026-08-14)
#
# Design: temp_files/ops/dv3ops_design_20260814.md
# Scope for ops sessions: scripts/ops/CLAUDE.md
#
# P0 implements the verbs the migration needs. Verbs from later phases are
# listed and fail with the phase that owns them rather than silently missing,
# so `dv3ops help` is an accurate map of what exists.
# ---------------------------------------------------------------------------
set -uo pipefail

DV3OPS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
source "$DV3OPS_ROOT/scripts/ops/lib/common.sh"

usage () {
  cat <<'USAGE'
dv3ops <verb> [args]

  P0 -- built
    push-repo N...          canonical whole-repo rsync + VERSION stamp + start watchdog
    versions [N...]         helper provenance per instance vs repo HEAD
    status N [--json]       dv3_status on one instance
    board-raw [N...]        dv3_status --json for each instance (raw; board.py is P2)
    sh N [cmd...]           ssh into instance N (no cmd = interactive)
    watch N [secs]          nvidia-smi + shard-log loop on instance N
    events N [k]            tail the instance event log (what the watchdog/queue emitted)
    migrate N               guided helper migration for a running instance (see §P0)
    selfcheck               local static checks of the ops library

  P1 -- built  (all take --wave <wave_id>)
    gen --wave W [--lanes 0,1,2,3]    spec -> commands, checker, rsync filters, bundle
    preflight N [--wave W]            assertions on an instance before submitting
    submit --wave W N                 approval prompt, then queue every lane
    check --wave W [--json|--pending] completion by realized counters, not markers
    requeue --wave W N                retry exactly the runs the checker says are not done
    pull --wave W N...                two-pass result pull from instance(s) to RCC
    bundle --wave W                   bundle + COMPLETION.txt + sha256 manifest
    pull-local --wave W               [WSL] bundle -> local_results, verify, stage manifest

  P2 -- built
    durations scan DIR...   backfill measured runtimes from _cloud_logs (--gpu 5060Ti)
    durations show          the measured table (derived twin of SU_usage.txt)
    refresh                 [WSL] vastai inventory -> instances.json/.env (sticky indices)
    board                   fleet table: every lane, progress, re-projected drain time
    pack --wave W           LPT lane assignment over measured durations (advisory)

  P3 -- built
    triage classify LOG...  match a failure log against failure_signatures.tsv
    triage brief --wave W   decision-ready brief: what failed, why, retry cost
    triage signatures       the signature table (append to it as you diagnose)
    digest [N...]           overnight: what happened, what self-healed, what
                            needs you, and idle GPU-hours burned

  P4 -- built
    archive-report          archive coverage + headroom (not delete-safety)

Instances resolve from ops/state/instances.env if present, else from IP<N>/PORT<N>
already exported in your shell.
USAGE
}

not_yet () { die "'$1' is $2 work; not built yet (see temp_files/ops/dv3ops_design_20260814.md §11)"; }

verb="${1:-help}"; shift || true

# Pull --wave/--lanes out of the argument list up front so each verb sees only
# its positional arguments.
WAVE=""; LANES=""; ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --wave)  WAVE="${2:?--wave needs a wave id}"; shift 2 ;;
    --lanes) LANES="${2:?--lanes needs a list}"; shift 2 ;;
    *)       ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS+"${ARGS[@]}"}

wave_dir () {
  [ -n "$WAVE" ] || die "this verb needs --wave <wave_id>"
  local d="$DV3OPS_ROOT/ops/waves/$WAVE"
  [ -d "$d" ] || die "no such wave: $d"
  printf '%s' "$d"
}

case "$verb" in

  push-repo)
    [ $# -gt 0 ] || die "usage: dv3ops push-repo N [N...]"
    # Per-instance isolation. dv3_push_repo calls die() on failure, and die()
    # exits the SCRIPT -- so a single unreachable instance used to abort the
    # loop and silently skip every one after it, leaving a fleet that looks
    # pushed because the command "finished".
    pr_ok=(); pr_bad=()
    for n in "$@"; do
      echo "=================== instance $n ==================="
      if ( dv3_push_repo "$n" ); then pr_ok+=("$n"); else pr_bad+=("$n"); fi
    done
    echo
    echo "push-repo: ${#pr_ok[@]} ok${pr_ok[*]+ (${pr_ok[*]})}"
    if [ ${#pr_bad[@]} -gt 0 ]; then
      echo "push-repo: ${#pr_bad[@]} FAILED (${pr_bad[*]}) -- these still run old code" >&2
      echo "           re-run individually to see the error:  dv3ops push-repo ${pr_bad[0]}" >&2
      exit 1
    fi
    # Confirm the stamp actually landed, rather than trusting that rsync ran.
    echo
    bash "$0" versions "$@"
    ;;

  versions)
    dv3_load_instances
    local_sha="$(git -C "$DV3OPS_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "repo HEAD: $local_sha"
    targets=("$@")
    if [ ${#targets[@]} -eq 0 ]; then
      mapfile -t targets < <(compgen -A variable | sed -n 's/^IP\([0-9]\+\)$/\1/p' | sort -n)
    fi
    [ ${#targets[@]} -gt 0 ] || die "no instances known (export IP<N>/PORT<N> or run refresh)"
    printf '%-6s %-34s %s\n' INST HELPERS STATUS
    for n in "${targets[@]}"; do
      v="$(dv3_ssh_dv3 "$n" 'dv3_version' 2>/dev/null | tail -1)"
      [ -n "$v" ] || v="UNREACHABLE"
      case "$v" in
        "$local_sha"*) st="ok" ;;
        UNREACHABLE)   st="-" ;;
        UNKNOWN*)      st="PRE-DV3OPS (needs push-repo)" ;;
        *)             st="SKEW (needs push-repo)" ;;
      esac
      printf '%-6s %-34s %s\n' "$n" "$v" "$st"
    done
    ;;

  status)
    n="${1:?usage: dv3ops status N [--json]}"; shift || true
    if [ "${1:-}" = "--json" ]; then
      dv3_ssh_dv3 "$n" 'dv3_status --json'
    else
      dv3_ssh_dv3 "$n" 'dv3_status'
    fi
    ;;

  board-raw)
    dv3_load_instances
    targets=("$@")
    if [ ${#targets[@]} -eq 0 ]; then
      mapfile -t targets < <(compgen -A variable | sed -n 's/^IP\([0-9]\+\)$/\1/p' | sort -n)
    fi
    for n in "${targets[@]}"; do
      # Capture, THEN print. Interleaving printf with a command whose output
      # ends in a newline splits each record across two lines, and a
      # line-oriented consumer then drops every one of them.
      st="$(dv3_ssh_dv3 "$n" 'dv3_status --json' 2>/dev/null | tail -1)"
      printf '{"instance":"%s","state":%s}\n' "$n" "${st:-null}"
    done
    ;;

  sh)
    n="${1:?usage: dv3ops sh N [cmd...]}"; shift || true
    if [ $# -eq 0 ]; then
      dv3_require_instance "$n"
      exec ssh -t -p "$(dv3_port "$n")" "${DV3_SSH_OPTS[@]}" "root@$(dv3_ip "$n")"
    else
      dv3_ssh_dv3 "$n" "$*"
    fi
    ;;

  watch)
    n="${1:?usage: dv3ops watch N [secs]}"; secs="${2:-15}"
    dv3_require_instance "$n"
    exec ssh -t -p "$(dv3_port "$n")" "${DV3_SSH_OPTS[@]}" "root@$(dv3_ip "$n")" \
      "bash -lc $(printf '%q' "source /root/.dreamer_vast_env; source /root/dreamer_instance_helpers.sh; dv3_watch $secs")"
    ;;

  events)
    n="${1:?usage: dv3ops events N [lines]}"; k="${2:-40}"
    dv3_ssh_dv3 "$n" "tail -n $k \"\$RUNROOT/_cloud_logs/events.jsonl\" 2>/dev/null || echo 'no events yet'"
    ;;

  migrate)
    n="${1:?usage: dv3ops migrate N}"
    exec bash "$DV3OPS_ROOT/scripts/ops/migrate_instance.sh" "$n"
    ;;

  selfcheck)
    exec bash "$DV3OPS_ROOT/scripts/ops/selfcheck.sh"
    ;;

  gen)
    exec python3 "$DV3OPS_ROOT/scripts/ops/wavegen.py" "$(wave_dir)" \
      ${LANES:+--lanes "$LANES"}
    ;;

  check)
    exec python3 "$DV3OPS_ROOT/scripts/ops/wavecheck.py" "$(wave_dir)" \
      --runroot "$RUNROOT" "$@"
    ;;

  preflight)
    n="${1:?usage: dv3ops preflight N [--wave W]}"
    if [ -n "$WAVE" ]; then
      w="$(wave_dir)"
      [ -f "$w/generated/preflight_remote.sh" ] ||
        die "no generated preflight for $WAVE -- run 'dv3ops gen --wave $WAVE' first"
      note "preflight instance $n against wave $WAVE"
      dv3_ssh_dv3 "$n" "bash -s" < "$w/generated/preflight_remote.sh"
    else
      dv3_ssh_dv3 "$n" '
        echo "== fork =="
        for f in scripts/env.sh scripts/ops/instance_helpers.sh; do
          [ -e "$REPO/$f" ] && echo "  PASS $f" || echo "  FAIL MISSING $f -- run push-repo"
        done
        echo "== helpers =="; dv3_version
        echo "== disk =="; df -h "$RUNROOT" | tail -1
        echo "== gpu =="; nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader'
    fi
    ;;

  submit)
    w="$(wave_dir)"
    n="${1:?usage: dv3ops submit --wave W <instance>}"
    [ -f "$w/generated/submit.sh" ] || die "run 'dv3ops gen' first"
    echo "About to submit to instance $n:"
    sed -n '1,12p' "$w/generated/RUN_IDS.txt"
    echo "Full list: $w/generated/RUN_IDS.txt"
    read -r -p "Submit? [y/N] " ans
    [ "$ans" = y ] || die "aborted"
    exec bash "$w/generated/submit.sh" "$n"
    ;;

  pull)
    w="$(wave_dir)"
    [ -f "$w/generated/pull_results.sh" ] || die "run 'dv3ops gen' first"
    exec bash "$w/generated/pull_results.sh" "$@"
    ;;

  bundle)
    w="$(wave_dir)"
    [ -f "$w/generated/bundle.sh" ] || die "this wave's spec declares no bundle"
    exec bash "$w/generated/bundle.sh"
    ;;

  requeue)
    w="$(wave_dir)"
    n="${1:?usage: dv3ops requeue --wave W <instance>}"
    pend="$(mktemp)"; trap 'rm -f "$pend"' EXIT
    python3 "$DV3OPS_ROOT/scripts/ops/wavecheck.py" "$w" --runroot "$RUNROOT" --pending > "$pend"
    cnt="$(wc -l < "$pend")"
    [ "$cnt" -gt 0 ] || { echo "nothing pending; wave is complete"; exit 0; }
    echo "$cnt run(s) not complete:"; cat "$pend"
    echo
    echo "These are regenerated verbatim from the original expansion -- same"
    echo "configs, same hardware unless you move them. If a cell failed for a"
    echo "reason a retry cannot fix (OOM), send it elsewhere instead."
    read -r -p "Requeue these on instance $n? [y/N] " ans
    [ "$ans" = y ] || die "aborted"
    python3 "$DV3OPS_ROOT/scripts/ops/wavegen.py" "$w" --only-runs "$pend" \
      --out "$w/generated_requeue" --quiet ${LANES:+--lanes "$LANES"}
    exec bash "$w/generated_requeue/submit.sh" "$n"
    ;;

  durations)
    exec python3 "$DV3OPS_ROOT/scripts/ops/durations.py" "$@"
    ;;

  pack)
    [ -n "$WAVE" ] || die "usage: dv3ops pack --wave W [--lanes 0,1,2,3] [--gpu 5060Ti]"
    exec python3 "$DV3OPS_ROOT/scripts/ops/packing.py" --wave "$WAVE" \
      ${LANES:+--lanes "$LANES"} "$@"
    ;;

  board)
    bash "$0" board-raw "$@" | python3 "$DV3OPS_ROOT/scripts/ops/board.py" ${GPU:+--gpu "$GPU"}
    ;;

  triage)
    exec python3 "$DV3OPS_ROOT/scripts/ops/triage.py" "$@" ${WAVE:+--wave "$WAVE"}
    ;;

  digest)
    # Gather events from every instance, merge, render. Instances keep their own
    # events.jsonl, so a digest works even if ntfy dropped or you never looked.
    dv3_load_instances
    targets=("$@")
    if [ ${#targets[@]} -eq 0 ]; then
      mapfile -t targets < <(compgen -A variable | sed -n 's/^IP\([0-9]\+\)$/\1/p' | sort -n)
    fi
    {
      for n in "${targets[@]}"; do
        dv3_ssh_dv3 "$n" 'cat "$RUNROOT/_cloud_logs/events.jsonl" 2>/dev/null || true' 2>/dev/null
      done
    } | python3 "$DV3OPS_ROOT/scripts/ops/digest.py" ${SINCE:+--since "$SINCE"}
    echo
    echo "=== board ==="
    bash "$0" board ${targets[@]+"${targets[@]}"} || true
    ;;

  archive-report)
    exec python3 "$DV3OPS_ROOT/scripts/ops/archive_report.py" --runroot "$RUNROOT" "$@"
    ;;

  pull-local)
    exec bash "$DV3OPS_ROOT/scripts/ops/pull_local.sh" ${WAVE:+--wave "$WAVE"} "$@"
    ;;

  refresh)
    exec python3 "$DV3OPS_ROOT/scripts/ops/refresh.py" "$@"
    ;;

  help|-h|--help) usage ;;
  *) usage; die "unknown verb: $verb" ;;
esac
